# Godot 4
.godot/
*.uid
/android/

# Per-machine import sidecars: Godot regenerates these per machine/editor;
# tracking them makes every pull demand a Discard Changes on the other side.
# All resources are referenced by path, so nothing needs them in the repo.
*.import

# Build/export output
/build/
/exports/
*.pck
*.exe
*.x86_64
*.apk

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
