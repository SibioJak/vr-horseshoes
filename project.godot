; Engine configuration file.
; VR Horseshoes — DE Toss Test (Godot 4.7, OpenXR, PCVR via editor)
; One pit, one stake, twenty shoes. The project lives or dies on the toss.

config_version=5

[application]

config/name="VR Horseshoes - Toss Test"
config/description="DE feel-test for VR Horseshoes: zone-snap grab + sticky slide, windowed release sampling, honest rigid-body shoe. Not a game."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[physics]

3d/run_on_separate_thread=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.35, 0.5, 0.32, 1)

[xr]

openxr/enabled=true
openxr/startup_alert=false
shaders/enabled=true
